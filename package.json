{
  "name": "platform-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:reference && vue-tsc --noEmit --project ./tsconfig.json && vite build",
    "build:android-release": "node scripts/check-android-release-env.mjs && npm run build",
    "preview": "vite preview --host 127.0.0.1",
