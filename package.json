    "build:reference": "node design/build-reference.mjs",
    "predev": "npm run build:reference"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/core": "7.6.10",
    "@capacitor/ios": "7.6.10",
    "qrcode": "1.5.4",
    "vue": "3.5.45",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@types/qrcode": "1.5.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "autoprefixer": "^10.4.0",
    "jsqr": "1.4.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.1.0"
  }
}
